{
  "name": "movie-night-bot",
  "version": "1.0.0",
  "description": "Telegram bot that helps users pick movies from their Letterboxd Watchlist",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
